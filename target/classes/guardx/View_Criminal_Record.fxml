<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="guardx.ViewCriminalRecordController"
            prefWidth="1200" prefHeight="700">

    <left>
        <fx:include source="officer_sidebar.fxml"/>
    </left>

    <center>
        <VBox fx:id="rootBox"
              spacing="20"
              style="-fx-padding: 25; -fx-background-color: #f3f4f6;">

            <!-- HEADER -->
            <VBox spacing="3" style="-fx-padding: 10 0 0 0;">
                <Label text="Criminal Record"
                       style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                <Label fx:id="userLabel"
                       text="Name (CNIC)"
                       style="-fx-text-fill: #374151; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>

            <!-- LIST OF FIRs -->
            <ListView fx:id="casesList"
                      style="-fx-background-insets: 0; -fx-padding: 0;"/>
        </VBox>
    </center>
</BorderPane>
