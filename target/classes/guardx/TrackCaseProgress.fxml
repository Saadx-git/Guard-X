<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.fxml.FXML?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="guardx.TrackCaseProgressController"
            prefWidth="1300" prefHeight="900"
            style="-fx-background-color: #f1f5f9;">

    <!-- =============== LEFT SIDEBAR (OFFICER SIDEBAR) =============== -->
    <left>
        <fx:include source="officer_sidebar.fxml"/>
    </left>

    <!-- =============== MAIN SCROLL CONTENT ========================== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #f1f5f9;">
            <VBox spacing="20" style="-fx-padding: 20; -fx-max-width: 1200;">

                <!-- Header -->
                <VBox spacing="5">
                    <Label text="Track Case Progress"
                           style="-fx-font-size: 28; -fx-font-weight: bold;"/>
                    <Label text="Monitor case timeline and add investigation notes"
                           style="-fx-text-fill: #64748b; -fx-font-size: 16;"/>
                </VBox>

                <!-- Case Selection -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                         -fx-effect: dropshadow(three-pass-box, #00000022, 6, 0.0, 0, 1);">
                    <Label text="Select Case" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="caseComboBox" promptText="Select a case..." prefWidth="400"/>
                </VBox>

                <!-- Timeline Card -->
                <VBox fx:id="timelineCard" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                              -fx-effect: dropshadow(three-pass-box, #00000022, 6, 0.0, 0, 1);">
                    <Label fx:id="timelineTitle" text="Case Timeline" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

                    <!-- FIXED: timelineContainer = HBox -->
                    <HBox fx:id="timelineContainer" spacing="20" alignment="CENTER_LEFT"/>
                </VBox>
                <!-- Add this to your FXML file -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Update Status:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="statusComboBox" prefWidth="150"/>
                    <Button fx:id="updateStatusButton" text="Update Status" style="-fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                </HBox>
                <!-- Case Details & Add Note -->
                <HBox spacing="20">

                    <!-- Case Details -->
                    <VBox fx:id="caseDetailsCard" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                                      -fx-effect: dropshadow(three-pass-box, #00000022, 6, 0.0, 0, 1);">
                        <Label text="Case Details" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                        <GridPane hgap="10" vgap="10">
                            <Label text="Case ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="caseIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Type:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="caseTypeLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Priority:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="casePriorityLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Assigned Officer:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="caseOfficerLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Current Status:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="caseStatusLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Add Note -->
                    <VBox fx:id="addNoteCard" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                                  -fx-effect: dropshadow(three-pass-box, #00000022, 6, 0.0, 0, 1);">
                        <Label text="Add Note" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="Document investigation progress" style="-fx-text-fill: #64748b;"/>

                        <TextArea fx:id="noteTextArea" promptText="Enter your notes here..." prefRowCount="5"/>

                        <Button fx:id="addNoteButton" text="Add Note"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- Notes Card -->
                <VBox fx:id="notesCard" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                            -fx-effect: dropshadow(three-pass-box, #00000022, 6, 0.0, 0, 1);">

                    <!-- FIXED AMPERSAND -->
                    <Label text="Case Notes &amp; Comments" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

                    <VBox fx:id="notesContainer" spacing="10"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
