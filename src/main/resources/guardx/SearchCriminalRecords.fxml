<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
    
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="guardx.SearchCriminalRecordsController" prefWidth="1200" prefHeight="700">

    <left>
        <fx:include source="officer_sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f3f4f6;" BorderPane.alignment="CENTER">

            <VBox spacing="5">
                <Label text="Search Civilian Users" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                <Label text="Search for individuals by name, CNIC, or User ID" style="-fx-text-fill: gray;"/>
            </VBox>

            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Enter name, CNIC, or User ID..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="searchButton" text="Search" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>
            </HBox>

            <HBox spacing="10" style="-fx-background-color: #fef3c7; -fx-border-color: #fde68a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;">
                <Label text="⚠ Authorized Personnel Only" style="-fx-text-fill: #b45309; -fx-font-weight: bold;"/>
                <Label text="Access is logged and monitored. Unauthorized searches are prohibited." style="-fx-text-fill: #b45309;"/>
            </HBox>

            <!-- ListView that expands to use all remaining space -->
            <ListView fx:id="resultsList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

</BorderPane>