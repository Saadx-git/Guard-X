<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="guardx.LaunchFirController"
            fitToWidth="true"
            style="-fx-background: #ffffff;">

    <VBox spacing="20"
          prefWidth="700"
          alignment="TOP_CENTER"
          style="-fx-padding: 20;">

        <Label text="Register New FIR"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

        <Separator />

        <!-- FIR Mode Selection -->
        <VBox spacing="5"
              maxWidth="600"
              style="-fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="Select FIR Type:" style="-fx-font-weight: bold;"/>
            
            <!-- Removed ToggleGroup from FXML -->
            <RadioButton fx:id="existingCaseRadio" text="Against Existing Case" userData="EXISTING"/>
            <RadioButton fx:id="newCaseRadio" text="New Case Registration" userData="NEW"/>
        </VBox>

        <!-- Existing Case Form -->
        <VBox fx:id="existingCaseForm" spacing="10" maxWidth="600" visible="false">
            <Label text="Select Incident:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="caseComboBox" promptText="Select accepted incident..." />

            <Label text="Officer Details:" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
            <HBox spacing="10">
                <Label text="Assigned Officer:" style="-fx-font-weight: bold;"/>
                <Label fx:id="assignedOfficerLabel"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Creator ID:" style="-fx-font-weight: bold;"/>
                <Label fx:id="creatorIdLabel"/>
            </HBox>

            <Label fx:id="existingCaseErrorLabel" style="-fx-text-fill: red;"/>
        </VBox>

        <!-- New Case Form -->
        <VBox fx:id="newCaseForm" spacing="10" maxWidth="600" visible="false">
            <Label text="New Case Details:" style="-fx-font-weight: bold;"/>

            <Label text="Case Title:"/>
            <ComboBox fx:id="titleComboBox" promptText="Select incident type..." />

            <Label text="Case Description:"/>
            <TextArea fx:id="descriptionTextArea"
                      promptText="Enter incident details..."
                      prefRowCount="4"/>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Priority:"/>
                    <ComboBox fx:id="priorityComboBox" />
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Status (Default):"/>
                    <TextField text="Investigating" editable="false"
                               style="-fx-background-color: #e5e7eb;"/>
                </VBox>
            </HBox>

            <Label fx:id="newCaseErrorLabel" style="-fx-text-fill: red;"/>
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 20 0;">
            <Button fx:id="cancelButton" text="Cancel"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
            <Button fx:id="submitButton" text="Register FIR"
                    style="-fx-background-color: #10b981; -fx-text-fill: white;"/>
        </HBox>

    </VBox>

</ScrollPane>
